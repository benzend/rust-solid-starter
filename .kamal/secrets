# Kamal reads secrets from here. This file holds only references, never values,
# so it's committed. Locally, export the variables first; in GitHub Actions the
# deploy workflow sets them from repository secrets.
# https://kamal-deploy.org/docs/configuration/environment-variables/

# A token that can push and pull images on ghcr.io. CI uses its GITHUB_TOKEN;
# locally, a personal access token with write:packages.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Generate with `openssl rand -hex 32` (hex avoids characters that need
# escaping in the URL below).
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# The host is the db accessory's container name: <service>-db. CHANGE ME if you
# rename the service in config/deploy.yml.
DATABASE_URL=postgres://app:$POSTGRES_PASSWORD@rust-solid-starter-db:5432/app

# Only if off-site backups are on (config/deploy.yml, backup accessory): an
# access key for the bucket, ideally allowed to write but not delete.
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=$RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=$RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY
