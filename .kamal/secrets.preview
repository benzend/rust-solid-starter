# Secrets for config/preview.yml. References only, never values, as in
# .kamal/secrets. The preview workflow sets these from repository secrets.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Shared by every preview's database; never production's password.
POSTGRES_PASSWORD=$PREVIEW_POSTGRES_PASSWORD

# The host is the PR's db accessory: <service>-db, with the service name from
# config/preview.yml.
DATABASE_URL=postgres://app:$PREVIEW_POSTGRES_PASSWORD@rust-solid-starter-pr-$PR_NUMBER-db:5432/app
