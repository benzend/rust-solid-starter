# Copy to .env (or run `make setup`). Matches the Postgres in compose.yaml.
# Wrap a value in single quotes if it contains `$`, e.g. a password:
# DATABASE_URL='postgres://app:pa$$word@localhost:5432/app'
DATABASE_URL=postgres://app:app@localhost:5432/app
PORT=3000
RUST_LOG=server=debug,tower_http=info
# Where users open the app: used in emailed links. https:// makes the session
# cookie Secure. In dev that's Vite.
APP_URL=http://localhost:5173
# Optional tuning (defaults shown).
# DB_MAX_CONNECTIONS=10
# REQUEST_TIMEOUT_SECS=10
# LOG_FORMAT=json   # the Docker image sets this; text is easier to read in dev
